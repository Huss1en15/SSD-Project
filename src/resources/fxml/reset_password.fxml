<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ResetPasswordController"
      style="-fx-padding: 20;">

    <Label text="Reset Password" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <PasswordField fx:id="oldPasswordField" promptText="Current Password" />
    <PasswordField fx:id="newPasswordField" promptText="New Password" />
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm New Password" />

    <Button text="Update Password" onAction="#handleChangePassword"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>
