<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.AdminController"
      style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #ffffff, #f0f0f0);">

    <Label text="Admin Panel - Approve/Reject Leave"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="requestIdField" promptText="Leave Request ID"
               style="-fx-pref-width: 250px;" />
    <HBox spacing="8">
        <Button text="Approve" onAction="#approveLeave" style="-fx-pref-width: 80px;"/>
        <Button text="Reject" onAction="#rejectLeave" style="-fx-pref-width: 80px;"/>
    </HBox>

    <Separator/>

    <Label text="Pending Leave Requests"
           style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="pendingLeaveTable" prefHeight="220" prefWidth="750">
        <columns>
            <TableColumn fx:id="leaveIdCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="leaveUserIdCol" text="User ID" prefWidth="60"/>
            <TableColumn fx:id="leaveNameCol" text="Name" prefWidth="100"/>
            <TableColumn fx:id="startDateCol" text="Start Date" prefWidth="100"/>
            <TableColumn fx:id="endDateCol" text="End Date" prefWidth="100"/>
            <TableColumn fx:id="reasonCol" text="Reason" prefWidth="250"/>
        </columns>
    </TableView>
    <Button text="Load Pending Leaves" onAction="#loadPendingLeaves" style="-fx-pref-width: 160px;"/>

    <Separator/>

    <Label text="Employee Attendance Records"
           style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="attendanceTable" prefHeight="220" prefWidth="750">
        <columns>
            <TableColumn fx:id="userIdCol" text="User ID" prefWidth="60"/>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="120"/>
            <TableColumn fx:id="clockInCol" text="Clock In" prefWidth="180"/>
            <TableColumn fx:id="clockOutCol" text="Clock Out" prefWidth="180"/>
            <TableColumn fx:id="workingHoursCol" text="Working Hours" prefWidth="100"/>
        </columns>
    </TableView>
    <Button text="Refresh Records" onAction="#loadAttendanceRecords" style="-fx-pref-width: 160px;"/>

    <Separator/>

    <Label text="Create User Account"
           style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TextField fx:id="createNameField" promptText="Full Name" style="-fx-pref-width: 250px;"/>
    <TextField fx:id="createUsernameField" promptText="Username" style="-fx-pref-width: 250px;"/>
    <PasswordField fx:id="createPasswordField" promptText="Temporary Password" style="-fx-pref-width: 250px;"/>
    <ComboBox fx:id="createRoleCombo" promptText="Role" style="-fx-pref-width: 250px;"/>
    <Button text="Create User" onAction="#handleCreateUser"
            style="-fx-pref-width: 160px; -fx-background-color: #4caf50; -fx-text-fill: white;"/>

    <Separator/>

    <Button text="Update Password" onAction="#handlePasswordReset"
            style="-fx-background-color: #9c27b0; -fx-text-fill: white; -fx-font-weight: bold;"/>

    <Button text="Logout" onAction="#handleLogout"
            style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>
