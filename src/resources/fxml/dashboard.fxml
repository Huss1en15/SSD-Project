<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ClockController"
      style="-fx-padding: 20; -fx-background-color: linear-gradient(to bottom, #ffffff, #eef2f7);">

    <Label text="Employee Dashboard"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

    <GridPane hgap="12" vgap="8" style="-fx-background-color: #f7f7f7; -fx-padding: 12; -fx-background-radius: 8;">
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="profileNameLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="profileUsernameLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label text="Role:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="profileRoleLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Leave Balance:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="leaveBalanceLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <Button text="Clock In" onAction="#handleClockIn"
            style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-pref-width: 150px; -fx-font-size: 12px;"/>
    <Button text="Clock Out" onAction="#handleClockOut"
            style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-pref-width: 150px; -fx-font-size: 12px;"/>
    <Button text="Request Leave" onAction="#openLeaveForm"
            style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-pref-width: 150px; -fx-font-size: 12px;"/>

    <Separator />

    <Label text="My Leave Requests"
           style="-fx-font-size: 14px; -fx-font-weight: bold;" />
    <TableView fx:id="leaveTable" prefHeight="180" prefWidth="700" style="-fx-font-size: 12px; -fx-cell-size: 24px;">
        <columns>
            <TableColumn fx:id="startDateCol" text="Start Date" />
            <TableColumn fx:id="endDateCol" text="End Date" />
            <TableColumn fx:id="reasonCol" text="Reason" />
            <TableColumn fx:id="statusCol" text="Status" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <Button text="Refresh Requests" onAction="#loadLeaveRequests"
            style="-fx-font-size: 11px; -fx-background-color: #607d8b; -fx-text-fill: white;" />

    <Separator />

    <Label text="My Attendance Records"
           style="-fx-font-size: 14px; -fx-font-weight: bold;" />
    <TableView fx:id="attendanceTable" prefHeight="180" prefWidth="700" style="-fx-font-size: 12px; -fx-cell-size: 24px;">
        <columns>
            <TableColumn fx:id="clockInCol" text="Clock In" />
            <TableColumn fx:id="clockOutCol" text="Clock Out" />
            <TableColumn fx:id="workingHoursCol" text="Working Hours" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <Button text="Refresh Attendance" onAction="#loadMyAttendance"
            style="-fx-font-size: 11px; -fx-background-color: #607d8b; -fx-text-fill: white;" />

    <Button text="Update Password" onAction="#handlePasswordReset"
            style="-fx-font-size: 11px; -fx-background-color: #9c27b0; -fx-text-fill: white;" />
    <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"
            style="-fx-font-size: 11px; -fx-background-color: #d9534f; -fx-text-fill: white;" />
</VBox>
